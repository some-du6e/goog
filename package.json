{
  "name": "goog-cli",
  "version": "0.1.0",
  "description": "Edit Google Docs and Slides as local .goog files",
  "type": "module",
  "bin": {
    "goog": "dist/bin/goog.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/some-du6e/goog.git"
  },
  "homepage": "https://github.com/some-du6e/goog",
  "license": "MIT",
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r skill dist/skill",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "node-diff3": "^3.2.1",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
